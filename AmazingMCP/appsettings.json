{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:7777",
  "Symbol": {
    "QueryOutputLineLimit": 100
  },
  "ReadCs": {
    "ReadOutputMaxLength": 30000
  },
  "ProjectDesign": {
    "DetailsOutputMaxLength": 30000,
    "DetailsXmlDocSummaryMaxLength": 2000
  },
  "QueryUsages": {
    "QueryMatchLimit": 200
  },
  "Diagnostics": {
    "IncludeExceptionDetails": false
  },
  "HttpServerTransport": {
    "IdleTimeout": "7.00:00:00"
  }
}
